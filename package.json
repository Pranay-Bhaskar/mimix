{
  "name": "mimix-cli",
  "version": "1.0.2",
  "publisher": "Pranay-Bhaskar",
  "description": "A lightweight, local-first API mock server with strict schema validation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pranay-Bhaskar/mimix.git"
  },
  "bugs": {
    "url": "https://github.com/Pranay-Bhaskar/mimix/issues"
  },
  "homepage": "https://github.com/Pranay-Bhaskar/mimix#readme",
  "keywords": [
    "mock",
    "api",
    "server",
    "zod",
    "testing",
    "cli",
    "hono",
    "local",
    "json-server",
    "fake-api",
    "proxy",
    "record",
    "replay",
    "schema",
    "rest",
    "frontend"
  ],
  "main": "src/extension.cjs",
  "type": "module",
  "bin": {
    "mimix": "./bin/mimix.js"
  },
  "files": [
    "src",
    "bin"
  ],
  "scripts": {
    "start": "node ./bin/mimix.js serve",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.11.1",
    "chalk": "^5.3.0",
    "chokidar": "^3.6.0",
    "commander": "^12.0.0",
    "get-port": "^7.2.0",
    "hono": "^4.3.0",
    "node-fetch": "^3.3.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "supertest": "^7.2.2",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=18.0.0",
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onCommand:mimix.toggleServer"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mimix.toggleServer",
        "title": "Mimix: Toggle Server"
      }
    ]
  }
}